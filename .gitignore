# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/

# Agent-driven UI driver (nmos/agentui/) — optional, never committed.
# .playwright/ holds a self-contained Chromium build (~656 MB) fetched by
# `playwright install chromium`; artifacts/ holds per-run journals and
# screenshots. Both are regenerable and must never enter git history.
.playwright/
artifacts/

# Distributed registry backend (nmos/etcd/).
#
# nmos/etcd/generated/ is deliberately NOT ignored: it is committed, exactly as
# nmos/types/generated/ is, so trying the distributed registry needs only
# `pip install -r requirements-etcd.txt` and `./install-etcd.sh` — no codegen
# step and no need to understand the build. Staleness is guarded by the proto
# fingerprint checked at startup, not by regenerating every time.
#
# .etcd/ holds the version-pinned etcd binaries fetched by ./install-etcd.sh
# plus the local cluster's data directories. It must never enter git history —
# .etcd/data/ in particular is a live database.
.etcd/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# ignore specs that are from another git repo
CLAUDE.md
AGENTS.md
bench_registry/.work/
