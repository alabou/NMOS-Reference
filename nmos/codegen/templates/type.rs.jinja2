{#-
  Rust emitter for one TypeDesc.

  Peer of type.py.jinja2, not a translation of it. The Python template produces
  two classes per type (NFooValue + NFoo), a `_defined` flag per member and an
  explicit clone() on every field, because it is emulating Go value semantics in
  a language with neither Option nor moves. Rust has both, so all of that
  evaporates: `_defined` IS Option<T>, clone() IS #[derive(Clone)], and the
  wrapper pair collapses to one struct.

  What does NOT change is behaviour. Decode runs in DESCRIPTOR order -- not
  document order -- then applies optional defaults, then checks required
  presence, then runs assertions. That sequence is observable: the decode
  exception's text goes straight into the HTTP 400 body a Node receives
  (nmos/registry/handlers_registration.py:158), so a body missing two members
  must name the same one Python would.

  #[derive(Deserialize)] cannot express it. Derive visits fields in the order
  the document lists them and fails on the first that will not parse, so
  {"version":"y","id":"x"} and {"id":"x","version":"y"} would report different
  errors where Python reports one. Hence a generated decode() rather than a
  derived one. Serialize IS derived: field order is declaration order is
  descriptor order, which is exactly the Python encoder's key order.
-#}
{#- The last four entries are pure aliases in nmos/json/types.py:
    NArrayOfNull(NNull), NArrayOfNullString(NNullString), and
    NArrayOfUrl/NArrayOfTime which both subclass NArrayOfString with `pass`.
    Their names promise more structure than they carry -- NArrayOfTime is an
    array of raw strings, never parsed into timestamps -- and that is
    reproduced here rather than improved on. -#}
{%- set base_map = {
  "NString":            ("String",           "decode::string",             "opt"),
  "NInt":               ("i64",              "decode::int",                "try"),
  "NFloat":             ("f64",              "decode::float",              "try"),
  "NBool":              ("bool",             "decode::bool",               "try"),
  "NEnum":              ("EnumId",           "decode::enum_id",            "try"),
  "NNull":              ("Nullable<Value>",  "decode::null_value",         "infallible"),
  "NNullString":        ("Nullable<String>", "decode::nullable_string",    "try"),
  "NHyperlink":         ("Hyperlink",        "decode::hyperlink",          "try"),
  "NUrl":               ("String",           "decode::url",                "try"),
  "NTime":              ("Tai",              "decode::tai",                "try"),
  "NTags":              ("Tags",             "decode::tags",               "try"),
  "NGeneric":           ("RawJson",            "decode::raw_json",            "infallible"),
  "NArrayOfString":     ("Vec<String>",      "decode::array_of_string",    "try"),
  "NArrayOfInt":        ("Vec<i64>",         "decode::array_of_int",       "try"),
  "NArrayOfFloat":      ("Vec<f64>",         "decode::array_of_float",     "try"),
  "NArrayOfBool":       ("Vec<bool>",        "decode::array_of_bool",      "try"),
  "NArrayOfEnum":       ("Vec<EnumId>",      "decode::array_of_enum",      "try"),
  "NArrayOfHyperlink":  ("Vec<Hyperlink>",   "decode::array_of_hyperlink", "try"),
  "NArrayOfGeneric":    ("Vec<Value>",       "decode::array_of_generic",   "try"),
  "NArrayOfNull":       ("Nullable<Value>",  "decode::null_value",         "infallible"),
  "NArrayOfNullString": ("Nullable<String>", "decode::nullable_string",    "try"),
  "NArrayOfUrl":        ("Vec<String>",      "decode::array_of_string",    "try"),
  "NArrayOfTime":       ("Vec<String>",      "decode::array_of_string",    "try"),
} -%}
{#- The two hand-written map types. They consume the parent object's leftover
    keys rather than one member, which no descriptor can express, so they are
    written by hand on both sides. -#}
{%- set handwritten = {
  "NConstraints":          "NConstraints",
  "NTransportConstraints": "NTransportConstraints",
} -%}
{#- Python emits NFoo and NFooValue from one descriptor; Rust collapses them
    to one struct, so a member naming the Value half resolves to the struct. -#}
{%- macro resolve(tn) -%}
{%- if tn.endswith("Value") and tn[:-5] in known -%}{{ tn[:-5] }}{%- else -%}{{ tn }}{%- endif -%}
{%- endmacro -%}
{#- How to hand a member to its Check* function. Derived from the member's
    base type: a string validator takes &str, an enum one takes &EnumId, an
    integer one takes i64, and an array one takes an iterator of &str. -#}
{#- A few validators do not take the member's value at all -- they take its
    length -- so their call shape follows the FUNCTION, not the member type.
    Keyed by assertion name, and checked first. -#}
{#- CheckTransportConstraintEnumLength sits on an NArrayOfNull member, so the
    value is whatever JSON arrived. Python calls len() on it directly, which
    raises TypeError for a non-list -- decode.py's except clause turns that
    crash into a 400. Rust treats a non-list as empty, so it still REJECTS, but
    with the "invalid empty" message rather than Python's TypeError text. A
    known message divergence, on input that is already malformed. -#}
{%- set assert_override = {
  "CheckDataEventTypes":               "{f}.len()",
  "CheckConstraintsLength":            "{f}.0.len()",
  "CheckTransportConstraintEnumLength": "{f}.as_option().and_then(serde_json::Value::as_array).map_or(0, Vec::len)",
} -%}
{#- The arrays-of-objects hand their ELEMENTS' checked members to the
    validator rather than the array itself, so `nmos-json` never has to know a
    generated element type. Each is a `#[serde(transparent)]` newtype, hence
    the `.0`. Which member gets read is fixed by the array type, so keying on
    that type is unambiguous even though the expression names an element
    field. -#}
{%- set assert_shape = {
  "NString":        "&{f}",
  "NUrl":           "&{f}",
  "NEnum":          "&{f}",
  "NInt":           "*{f}",
  "NFloat":         "*{f} as i64",
  "NGeneric":       "{f}",
  "NNull":          "{f}.as_json()",
  "NNullString":    "{f}.as_option().map(String::as_str)",
  "NArrayOfString": "{f}.iter().map(String::as_str)",
  "NArrayOfEnum":   "{f}.iter().map(nmos_json::EnumId::as_str)",
  "NArrayOfVideoComponent": "{f}.0.iter().map(|e| Some(e.name.as_str()))",
  "NArrayOfAudioChannel":   "{f}.0.iter().map(|e| e.symbol.as_ref().map(nmos_json::EnumId::as_str))",
  "NArrayOfDidSdid":        "{f}.0.iter().map(|e| (e.did.as_deref(), e.sdid.as_deref()))",
} -%}
{%- set is_polymorphic = t.poly_types | length > 0 -%}
{%- set is_simple_value = t.is_value and not is_polymorphic and not t.is_array -%}
{#- Members that never appear in JSON. Python emits them as internal-only
    fields; here they would be dead struct fields nothing can reach. -#}
{%- set wire = t.members | rejectattr("json_key", "equalto", "-") | list -%}
{%- set imports = [] -%}
{%- set import_src = t.members if (t.is_array or is_simple_value) else wire -%}
{%- for m in import_src -%}
  {%- set tn = m.type_name -%}
  {%- if tn.startswith("list[") -%}
    {%- set inner = tn[5:-1] -%}
    {%- if inner not in base_map and inner not in handwritten and inner != "object" and inner not in imports -%}
      {%- if imports.append(resolve(inner)|string) %}{% endif -%}
    {%- endif -%}
  {%- elif tn not in base_map and tn not in handwritten and tn != "object" and tn not in imports -%}
    {%- if imports.append(resolve(tn)|string) %}{% endif -%}
  {%- endif -%}
{%- endfor -%}
