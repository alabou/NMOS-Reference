//!
//! Rendered from `nmos/codegen/definitions/` by
//! `nmos/codegen/templates/type.rs.jinja2`. The descriptors are the source of
//! truth and the Python tree in `nmos/types/generated/` is rendered from the
//! same ones, so the two describe one model by construction.
//!
//! Regenerate with: `python -m nmos.codegen.generate`

#[allow(unused_imports)]
use nmos_json::error::{Error, Result};
#[allow(unused_imports)]
use nmos_json::{decode, validators, EnumId, Hyperlink, Nullable, RawJson, Tags, Tai};
use serde::Serialize;
#[allow(unused_imports)]
use serde_json::Value;
{% for dep in imports | sort %}
use crate::generated::{{ dep | to_snake }}::{{ dep }};
{% endfor %}
{% for m in wire if m.type_name in handwritten %}
use crate::handwritten::{{ handwritten[m.type_name] }};
{% endfor %}

{% if is_polymorphic %}
{#- Variant names strip the parent's prefix when it is one: NSourceVideo under
    NSource becomes NSource::Video. Mechanical, and it keeps a match arm
    readable without inventing names. -#}
{%- macro variant(pt) -%}
{%- if pt.startswith(t.name) and pt[t.name|length:] -%}{{ pt[t.name|length:] }}{%- else -%}{{ pt }}{%- endif -%}
{%- endmacro -%}
{% for pt in t.poly_types %}
use crate::generated::{{ pt | to_snake }}::{{ pt }};
{% endfor %}

/// `{{ t.name }}`: a discriminated union over {{ t.poly_types | length }} concrete types.
///
/// # Dispatch is ordered and committal
///
/// The variants are tried in the order the model declares them, and the FIRST
/// whose predicate matches decides the type -- its decode error is the answer,
/// even when a later variant would have decoded cleanly. Python behaves the
/// same way, and that is why this is not `#[serde(untagged)]` on the way in:
/// untagged picks the first variant that *deserialises*, not the first whose
/// *discriminator* matches, and it backtracks. A body whose `format` says
/// video but whose components are empty must report the empty components, not
/// fall through and be mistaken for something else.
///
/// Declaration order is load-bearing for a second reason: some predicates only
/// exclude (`notin`), so a variant declared later may match a superset of an
/// earlier one. The emitter never sorts these.
///
/// `Serialize` IS untagged, which is correct on the way out -- it writes the
/// inner value with no added tag, exactly as Python's type-switch encode does.
#[derive(Debug, Clone, PartialEq, Serialize)]
#[serde(untagged)]
// Variants differ in size because the concrete NMOS types do. Boxing them to
// even that out would change the public shape of every match arm, for a type
// that is decoded once per registration and then dropped.
#[allow(clippy::large_enum_variant)]
pub enum {{ t.name }} {
{% for pt in t.poly_types %}
    /// `{{ pt }}`.
    {{ variant(pt) }}({{ pt }}),
{% endfor %}
}

{% for pt in t.poly_types %}
/// Does this object discriminate as `{{ pt }}`?
{% if pt in t.predicates and t.predicates[pt] %}
fn is_{{ pt | to_snake }}(doc: &serde_json::Map<String, Value>) -> bool {
{% for json_key, expected, comparison in t.predicates[pt] %}
{% if comparison == "eq" %}
{% if expected.isdigit() or (expected.startswith("-") and expected[1:].isdigit()) %}
    if doc.get({{ json_key | rust_str }}).and_then(Value::as_f64) != Some({{ expected }}_f64) {
        return false;
    }
{% else %}
    if doc.get({{ json_key | rust_str }}).and_then(Value::as_str) != Some({{ expected | rust_str }}) {
        return false;
    }
{% endif %}
{% elif comparison == "neq" %}
    // Excluding, so the key must be PRESENT and different -- absence fails.
    if doc.get({{ json_key | rust_str }}).and_then(Value::as_str) == Some({{ expected | rust_str }}) {
        return false;
    }
    if !doc.contains_key({{ json_key | rust_str }}) {
        return false;
    }
{% elif comparison == "in" %}
    {
        const ALLOWED: &[&str] = &[
{% for val in expected.split(",") %}
            {{ val | rust_str }},
{% endfor %}
        ];
        match doc.get({{ json_key | rust_str }}).and_then(Value::as_str) {
            Some(v) if ALLOWED.contains(&v) => {}
            _ => return false,
        }
    }
{% elif comparison == "notin" %}
    {
        const EXCLUDED: &[&str] = &[
{% for val in expected.split(",") %}
            {{ val | rust_str }},
{% endfor %}
        ];
        if let Some(v) = doc.get({{ json_key | rust_str }}).and_then(Value::as_str)
            && EXCLUDED.contains(&v)
        {
            return false;
        }
        // Excluding, so absence fails as well as membership.
        if !doc.contains_key({{ json_key | rust_str }}) {
            return false;
        }
    }
{% elif comparison == "type_bool" %}
    // Hardcoded to "enum", ignoring this predicate's json_key -- Python does
    // the same, and the difference is not observable because every caller
    // passes "enum" anyway.
    match doc.get("enum").and_then(Value::as_array) {
        Some(items) => match items.first() {
            Some(first) if first.is_boolean() => {}
            _ => return false,
        },
        None => return false,
    }
{% elif comparison == "type_str" %}
    match doc.get("enum").and_then(Value::as_array) {
        Some(items) => match items.first() {
            Some(first) if first.is_string() => {}
            _ => return false,
        },
        None => return false,
    }
{% elif comparison == "type_int" or comparison == "type_float" %}
    {
        // Python spells this `data.get("enum", data.get("minimum",
        // data.get("maximum")))`, and evaluates those defaults EAGERLY -- so it
        // selects on key PRESENCE, taking "enum" even when its value is null.
        let probe = if doc.contains_key("enum") {
            doc.get("enum")
        } else if doc.contains_key("minimum") {
            doc.get("minimum")
        } else {
            doc.get("maximum")
        };
        let ok = match probe {
            Some(Value::Array(items)) if !items.is_empty() => {
                let Some(first) = items.first() else { return false };
{% if comparison == "type_int" %}
                // A bool is excluded: `isinstance(True, int)` is true in
                // Python, so it says so explicitly. Here the variants are
                // already distinct and the outcome is the same.
                first.is_i64() || first.is_u64()
{% else %}
                // An int is NOT a float to `isinstance`, so `5` fails here.
                first.is_f64()
{% endif %}
            }
            Some(Value::Array(_)) => false,
{% if comparison == "type_int" %}
            Some(v) => v.is_i64() || v.is_u64(),
{% else %}
            Some(v) => v.is_f64(),
{% endif %}
            None => false,
        };
        if !ok {
            return false;
        }
    }
{% elif comparison == "fallback" %}
    // Always matches; declared last so it is the last resort.
    let _ = doc;
{% endif %}
{% endfor %}
    true
}
{% else %}
fn is_{{ pt | to_snake }}(_doc: &serde_json::Map<String, Value>) -> bool {
    // No predicate in the model: this variant always matches, so its position
    // in the declaration order is what stops it shadowing the rest.
    true
}
