        validators::{{ fname }}({{ arg.replace("*{f}", m.name | rust_ident | string).replace("{f}", m.name | rust_ident | string) }})?;
{% endif %}
{% else %}
        // {{ m.assertion }} on a {{ m.type_name }} member has no call shape in
        // this emitter yet; it is recorded as an unported assertion rather than
        // silently dropped. See the decode parity test's allowlist.
{% endif %}
{% endfor %}
{% endif %}

        Ok(Self {
{% for m in wire %}
            {{ m.name | rust_ident }},
{% endfor %}
        })
    }
}
{% endif %}
