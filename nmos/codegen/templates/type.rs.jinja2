{% else %}
{% if m.type_name in base_map %}
{% set fn, mode = base_map[m.type_name][1], base_map[m.type_name][2] %}
{% if mode == "infallible" %}
        Ok(Self({{ fn }}(src)))
{% elif mode == "opt" %}
        Ok(Self({{ fn }}(src)?.unwrap_or_default()))
{% else %}
